rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function validScore(uid) {
      let data = request.resource.data;
      return request.auth != null
        && request.auth.uid == uid
        && data.keys().hasOnly([
          'uid', 'username', 'level', 'hitCount', 'bestCombo', 'elapsed',
          'total', 'rankScore', 'schemaVersion', 'createdAt', 'updatedAt'
        ])
        && data.uid == uid
        && data.username is string
        && data.username.size() >= 1
        && data.username.size() <= 10
        && data.level is int && data.level >= 1 && data.level <= 100
        && data.hitCount is int && data.hitCount >= 0 && data.hitCount <= 100000
        && data.bestCombo is int && data.bestCombo >= 0 && data.bestCombo <= 10000
        && data.elapsed is int && data.elapsed >= 0 && data.elapsed <= 86400000
        && data.total is int && data.total >= 0 && data.total <= 10000000
        && data.rankScore is int
        && data.rankScore == data.level * 1000000000000
          + data.hitCount * 1000000
          + data.bestCombo * 100
        && data.schemaVersion == 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow create: if validScore(uid);
      allow update: if validScore(uid)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.rankScore >= resource.data.rankScore;
      allow delete: if false;
    }
  }
}
